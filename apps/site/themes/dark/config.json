{
  "name": "dark",
  "version": "1.0.0",
  "author": "Blog Team",
  "description": "暗色主题，适合夜间阅读",
  "colors": {
    "primary": "#60A5FA",
    "secondary": "#94A3B8",
    "accent": "#A78BFA",
    "background": "#0F172A",
    "surface": "#1E293B",
    "text": "#F1F5F9",
    "textMuted": "#94A3B8"
  },
  "fonts": {
    "heading": "Inter, system-ui, sans-serif",
    "body": "Inter, system-ui, sans-serif",
    "mono": "JetBrains Mono, monospace"
  },
  "spacing": {
    "unit": "8px",
    "containerMax": "720px",
    "contentPadding": "24px"
  },
  "borderRadius": {
    "small": "4px",
    "medium": "8px",
    "large": "16px"
  },
  "layout": {
    "headerPosition": "sticky",
    "sidebarPosition": "right",
    "footerStyle": "minimal",
    "showSidebar": true,
    "navLinks": [
      { "label": "首页", "to": "/" },
      { "label": "文章", "to": "/articles" },
      { "label": "关于", "to": "/about" }
    ],
    "sidebarComponents": ["category-nav", "tag-cloud"]
  },
  "shadows": {
    "sm": "0 1px 2px rgba(0,0,0,0.3)",
    "md": "0 4px 6px rgba(0,0,0,0.4)",
    "lg": "0 10px 15px rgba(0,0,0,0.5)"
  },
  "transitions": {
    "fast": "0.15s ease",
    "normal": "0.3s ease",
    "slow": "0.5s ease"
  },
  "components": {
    "articleCard": {
      "showExcerpt": true,
      "showDate": true,
      "showAuthor": false,
      "showCover": true,
      "excerptLines": 2
    },
    "articleContent": {
      "maxWidth": "720px",
      "lineHeight": 1.75
    }
  }
}
