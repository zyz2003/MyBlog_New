{
  "name": "default",
  "version": "1.0.0",
  "author": "Blog Team",
  "description": "默认主题，简洁清爽的博客风格",
  "colors": {
    "primary": "#3B82F6",
    "secondary": "#64748B",
    "accent": "#8B5CF6",
    "background": "#FFFFFF",
    "surface": "#F8FAFC",
    "text": "#0F172A",
    "textMuted": "#64748B"
  },
  "fonts": {
    "heading": "Inter, system-ui, sans-serif",
    "body": "Inter, system-ui, sans-serif",
    "mono": "JetBrains Mono, monospace"
  },
  "spacing": {
    "unit": "8px",
    "containerMax": "720px",
    "contentPadding": "24px"
  },
  "borderRadius": {
    "small": "4px",
    "medium": "8px",
    "large": "16px"
  },
  "layout": {
    "headerPosition": "sticky",
    "sidebarPosition": "right",
    "footerStyle": "simple",
    "showSidebar": true,
    "navLinks": [
      { "label": "首页", "to": "/" },
      { "label": "文章", "to": "/articles" },
      { "label": "关于", "to": "/about" }
    ],
    "sidebarComponents": ["category-nav", "tag-cloud"]
  },
  "shadows": {
    "sm": "0 1px 2px rgba(0,0,0,0.05)",
    "md": "0 4px 6px rgba(0,0,0,0.1)",
    "lg": "0 10px 15px rgba(0,0,0,0.1)"
  },
  "transitions": {
    "fast": "0.15s ease",
    "normal": "0.3s ease",
    "slow": "0.5s ease"
  },
  "components": {
    "articleCard": {
      "showExcerpt": true,
      "showDate": true,
      "showAuthor": false,
      "showCover": true,
      "excerptLines": 2
    },
    "articleContent": {
      "maxWidth": "720px",
      "lineHeight": 1.75
    }
  }
}
